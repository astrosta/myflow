# 宿主机 / 服务器 IP。Langfuse NEXTAUTH_URL、前端对外端口（:2026）都引用它。
MYFLOW_HOST=127.0.0.1

# OpenSandbox 卷源：Docker/宿主机上的项目根绝对路径。
# config.yaml 的 sandbox.opensandbox.host_mount.host_root、opensandbox.toml
# 的 allowed_host_paths、backend-compose 的 .myflow/skills 挂载都读它。
# SANDBOX_HOST_ROOT=/opt/myflow

DEEPSEEK_API_KEY="sk-xxxx"
DEEPSEEKK_BASE_URL="https://api.deepseek.com"
# Knowledge base (uncomment after enabling knowledge_base in config.yaml)
# MINERU_API_KEY=""

# Skills Git SSH key: base64 of an OpenSSH private key (keep this file private).
# Generate with: base64 -w0 /path/to/skills_deploy_key
# SKILLS_GIT_SSH_KEY=

# Langfuse（远程自建；启用 observability.langfuse 后再取消注释）
# 不要把 secret 写进 config.yaml 或提交到版本库。
# LANGFUSE_BASE_URL="https://langfuse.example.internal"
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_USER_ID_SALT="至少 16 字符，独立于 AUTH_JWT_SECRET"
