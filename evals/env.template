# Copy to evals/.env (do not commit real secrets).
# Real process env vars override values loaded via --env-file.
#
#   cp evals/env.template evals/.env

# Gateway base URL (with or without trailing /api)
AGENT_API=http://127.0.0.1:8001/api

# Must match Agent tracing user_id_salt
USER_ID_SALT=replace-with-the-same-salt-as-gateway

# Fixed eval accounts: label -> {username, password}
# Prefer --accounts-file in CI so passwords stay out of checkout.
AGENT_USERS={"analyst_a":{"username":"alice","password":"change-me"}}

# Required for run / real build (not for LLM build dry-run)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Required for build --llm-synthesis and LLM metrics (the usage guide's build flow).
# Any OpenAI-compatible /chat/completions endpoint. Never commit the key.
EVAL_JUDGE_BASE_URL=https://api.deepseek.com/v1
EVAL_JUDGE_API_KEY=sk-...
EVAL_JUDGE_MODEL=deepseek-chat
# Optional judge tuning
# EVAL_JUDGE_TEMPERATURE=0
# EVAL_JUDGE_TIMEOUT_SECONDS=60
# EVAL_JUDGE_MAX_TOKENS=2048

# auto (DeepEval when the llm extra is installed), prompt, or deepeval.
# EVAL_METRIC_ENGINE=auto
# CI samples LLM metrics with this fixed-seed fraction; full mode uses 1.0.
# EVAL_LLM_SAMPLE=0.2
# EVAL_LLM_SEED=agent-eval
