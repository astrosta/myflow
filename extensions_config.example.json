{
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_TOKEN": "$GITHUB_TOKEN" },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60
    },
    "internal": {
      "enabled": false,
      "type": "http",
      "url": "https://mcp.internal.example.test/mcp",
      "headers": { "X-Client": "myflow" },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "_comment": "凭据四层：oauth < user_auth < headers_from_context；stdio 上这三层跳过（用 env）",
      "oauth": {
        "type": "client_credentials",
        "token_url": "https://auth.internal.example.test/token",
        "client_id": "$MCP_CLIENT_ID",
        "client_secret": "$MCP_CLIENT_SECRET",
        "scope": "mcp.read"
      },
      "user_auth": {
        "users": { "alice": { "X-Api-Key": "$ALICE_MCP_KEY" } },
        "on_missing": "fail_closed"
      },
      "headers_from_context": { "X-Request-Token": "MCP_REQUEST_TOKEN" }
    }
  },
  "skills": {
    "pdf-processing": { "enabled": true }
  }
}
