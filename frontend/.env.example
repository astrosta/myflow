# 网关（M3 的 LangGraph Platform 兼容层）
# 浏览器侧发请求用的前缀，保持同源，由 nginx / next rewrites 代理到真实网关。
NEXT_PUBLIC_API_BASE_URL=/api
# 服务端（RSC / route handler）直连网关时用，不要下发到浏览器。
GATEWAY_INTERNAL_URL=http://127.0.0.1:8001

# 附件上传：走 nginx 的 upload 路由，需 proxy_request_buffering off
NEXT_PUBLIC_MAX_UPLOAD_BYTES=26214400

# 只读 artifact 预览的上限（§6.5：HTTP byte range 只取前 1 MiB）
NEXT_PUBLIC_ARTIFACT_PREVIEW_BYTES=1048576
# ---------------------------------------------------------------------------
# 开发时的认证 origin（M9 §2.6）—— 注意这是**后端**的环境变量，放在这里是为了
# 和前端一起看到，实际要进 backend 的 .env / 进程环境。
#
# 网关只接受两种 Origin：
#   1. GATEWAY_CORS_ORIGINS 里列出的
#   2. 和请求 Host 同源的
#
# 生产没问题：nginx 同时服务页面和 /api，浏览器发的 Origin 就是同一个 host。
# 但开发时浏览器在 :3000、next.config.ts 的 rewrites 把 /api 转到 :8001，
# 网关看到的 Origin 是 :3000 而 Host 是 :8001 —— 对不上，**登录会被拒**：
#
#   origin http://127.0.0.1:3000 is not allowed
#
# 所以本地开认证时必须设：
#   GATEWAY_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
#
# CSRFMiddleware 和 CORSMiddleware 读的是同一个变量（§2.6），设一次就够。
# ---------------------------------------------------------------------------
