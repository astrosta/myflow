# 由 docker/docker-compose.yml 以 env_file 挂给 langfuse-web、langfuse-worker、
# clickhouse、langfuse-minio。容器之间走 compose 服务名。
# 浏览器打开 Langfuse 的地址在 compose 里用 MYFLOW_HOST 拼到 3050。
# S3 直传只走本机 127.0.0.1:9090，不对外。

# 与本 compose 的 postgres 服务共用实例，用默认库 postgres，不占用 myflow。
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# Langfuse 安全配置
SALT=8f2c9a7d4e1b6f3a0c5d8e9b2f7a1c6d
ENCRYPTION_KEY=7a3e9c1f5d8b2a6e4f0c9d7b1a5e3f8c6d2b0a9e7f4c1d5b8a6e2f0c9d3b7a1e
NEXTAUTH_SECRET=Qm7xK9pL2vN8cR4wT6yH1jF5sD3aB0eG

# ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=12345678

# 与本 compose 的 redis 服务共用。default 用户已关闭，必须用 myflow。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=123456
REDIS_USERNAME=myflow

# langfuse-minio，与 Milvus 的 minio 分开。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO Event Storage
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minioadmin
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=minioadmin

# 浏览器直传地址由 compose 用 MYFLOW_HOST 拼到 9090。服务端读写走内部地址。
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minioadmin
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=minioadmin

# Batch Export Storage
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minioadmin
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=minioadmin
