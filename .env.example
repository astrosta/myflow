# OpenSandbox 卷源：Docker/宿主机上的项目根绝对路径。
# config.yaml 的 sandbox.opensandbox.host_mount.host_root、opensandbox.toml
# 的 allowed_host_paths、backend-compose 的 .myflow/skills 挂载都读它。
SANDBOX_HOST_ROOT=/opt/myflow
DATABASE_URL="sqlite:///./myflow.db"
# OpenSandbox 数据面若返回 host.docker.internal，映射成 docker0 网关。
# DOCKER0_IP=172.17.0.1

DEEPSEEK_API_KEY="sk-xxxx"
DEEPSEEKK_BASE_URL="https://api.deepseek.com"
# Knowledge base (uncomment after enabling knowledge_base in config.yaml)
# MINERU_API_KEY=""

# ---- 依赖地址（网关在 backend-compose 容器内、加入 myflow-deps_default 时）----
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/myflow"
# REDIS_URL="redis://myflow:123456@redis:6379/0"
# VECTOR_STORE_URI="http://milvus:19530"
# OPENVIKING_URL="http://openviking:1933"
# OPEN_SANDBOX_DOMAIN="opensandbox:8080"
# SKILLS_GIT_REPOSITORY="ssh://git@gitea:22/admin/myflow-skills.git"

# MCP 服务：headers 的 Fernet 密钥（32 url-safe base64 字节）。
# config.yaml 的 mcp_servers.encryption_key 写 $MYFLOW_MCP_SERVER_KEY。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 不要复用 AUTH_JWT_SECRET：轮换它等于作废所有已存的 header。不要把真钥匙提交进仓库。
# MYFLOW_MCP_SERVER_KEY=""

# Skills Git SSH key: base64 of an OpenSSH private key (keep this file private).
# Generate with: base64 -w0 /path/to/skills_deploy_key
# SKILLS_GIT_SSH_KEY=

# Langfuse（远程自建；启用 observability.langfuse 后再取消注释）
# 不要把 secret 写进 config.yaml 或提交到版本库。
# NEXTAUTH_URL / 浏览器打开地址用公网，例如 http://<服务器IP>:3050
# backend-compose 会把容器内 LANGFUSE_BASE_URL 覆盖成 http://langfuse-web:3000
# LANGFUSE_BASE_URL="http://127.0.0.1:3050"
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_USER_ID_SALT="至少 16 字符，独立于 AUTH_JWT_SECRET"
