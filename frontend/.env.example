# 网关（M3 的 LangGraph Platform 兼容层）
# 浏览器侧发请求用的前缀，保持同源，由 nginx / next rewrites 代理到真实网关。
NEXT_PUBLIC_API_BASE_URL=/api
# 服务端（RSC / route handler）直连网关时用，不要下发到浏览器。
GATEWAY_INTERNAL_URL=http://127.0.0.1:8001

# 附件上传：走 nginx 的 upload 路由，需 proxy_request_buffering off
NEXT_PUBLIC_MAX_UPLOAD_BYTES=26214400

# 只读 artifact 预览的上限（§6.5：HTTP byte range 只取前 1 MiB）
NEXT_PUBLIC_ARTIFACT_PREVIEW_BYTES=1048576
